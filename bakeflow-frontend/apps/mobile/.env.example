# BakeFlow mobile — runtime configuration.
#
# Copy to apps/mobile/.env and fill in. Expo inlines EXPO_PUBLIC_* at BUILD time, so a
# running bundler will not pick up changes: restart with `npx expo start --clear`.
#
# Only the anon/publishable key belongs here. The service-role key must never appear in
# this app: RLS does not constrain a service-role caller (API-CONTRACT.md §165), so one
# reaching a phone would defeat every policy in the database at once.

EXPO_PUBLIC_SUPABASE_URL=https://tvfyxpafbpnkneujcnvr.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
