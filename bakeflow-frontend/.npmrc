# BakeFlow toolchain policy — see docs decision §13.
#
# No dependency lifecycle script runs automatically. npm 10.8.2 has no
# approve-scripts/deny-scripts mechanism (that is npm 11 only), so the only way
# to hold "run nothing that is not explicitly required" on this npm line is to
# deny by default here and rebuild required native packages by name:
#
#   npm rebuild @shopify/react-native-skia
#
# Do not remove this line to make an install "work". Add a documented rebuild
# instead, and only for a package BakeFlow actually requires natively.
ignore-scripts=true

# npm version reproducibility.
#
# `packageManager: npm@10.8.2` in package.json is honoured by Corepack, which
# ships with Node. Corepack can shim npm WITHOUT a global `corepack enable`
# (that needs admin on Windows because it writes into the Node install dir):
#
#   corepack npm install      -> resolves to npm 10.8.2
#   corepack npm ci           -> the CI entry point (`npm run ci:install`)
#
# `engines.npm` makes a mismatched npm warn loudly rather than silently drift.
# engine-strict is deliberately NOT set: it would also enforce every transitive
# dependency's engine range and fail installs for unrelated reasons.
