# BakeFlow — environment configuration contract
#
# Copy to `.env` (never commit `.env`). Values below are placeholders.
#
# Rules:
#   - EXPO_PUBLIC_* is embedded in the shipped app bundle and is PUBLIC. A secret
#     placed here is a disclosed secret. Server-side credentials NEVER go here.
#   - Server-side values are set with `supabase secrets set`, not from this file.
#   - Everything in the ACTIVE section has, or will immediately have, a real
#     consumer. Everything in the RESERVED section is commented out because it
#     has no consumer today. Uncomment a variable in the same change that
#     introduces the code reading it.


# =============================================================================
# ACTIVE — frontend (apps/mobile)
# =============================================================================

# Supabase project URL for the mobile client.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable/anon client key. Safe to ship: it is constrained by RLS.
# NEVER put the service-role key here.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Frontend runtime environment: development | staging | production.
EXPO_PUBLIC_APP_ENV=development


# =============================================================================
# NOT CONFIGURED HERE — sourced from app config, not the environment
# =============================================================================
#
#   Deep-link scheme       -> app.json `scheme`; read via Constants.expoConfig.scheme
#                             or Linking.createURL(). The scheme is registered
#                             natively at build time, so an env var cannot change
#                             it and can only drift from what the OS registered.
#
#   EAS project ID         -> app.json `extra.eas.projectId`; read by
#                             Notifications.getExpoPushTokenAsync({ projectId }).
#
# Auto-injected into every Edge Function by the Supabase runtime. Do NOT set
# these; `supabase secrets set` rejects the reserved SUPABASE_ prefix:
#
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_DB_URL


# =============================================================================
# RESERVED — no consumer yet. Uncomment with the code that reads it.
# =============================================================================

# --- Edge Function runtime (P6.1 & P6.2)
# Set via `supabase secrets set` in cloud/remote, or in .env for local functions
# APP_ENV=development                        # development | staging | production
# APP_BASE_URL=https://YOUR_APP_DOMAIN       # canonical URL for web/API links (optional)
# MOBILE_DEEP_LINK_SCHEME=bakeflow           # scheme used when building invite/notification links

# --- Invitation email delivery (P6.2 / Resend adapter)
# (NOTIFICATION-DELIVERY-CHANNELS.md §4-11. Uses EmailProvider adapter abstraction)
# EMAIL_PROVIDER=resend                      # resend | mock (defaults to mock if RESEND_API_KEY is empty)
# EMAIL_FROM_ADDRESS=invites@bakeflow.app    # verified sender address
# EMAIL_FROM_NAME=BakeFlow                   # sender display name
# RESEND_API_KEY=re_123456789                # server-only Resend API key


# --- Phase 2: push infrastructure
# (Blocked: no notification tables and no push-token column on sync_devices.
#  See PROJECT-OVERVIEW.md §146.)
# EXPO_ACCESS_TOKEN=                         # server-only Expo Push access token
# EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send

# --- Phase 4: SMS / WhatsApp
# (Explicitly deferred — "add only when customer/operational workflows require
#  them". Vendors below are candidate adapters, not decisions.)
# SMS_PROVIDER=
# SMS_FROM_NUMBER=+10000000000
# TWILIO_ACCOUNT_SID=                        # server-only
# TWILIO_AUTH_TOKEN=                         # server-only
# WHATSAPP_PROVIDER=
# WHATSAPP_FROM_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=                     # server-only
# WHATSAPP_API_VERSION=v23.0

# --- Optional observability (no Sentry package installed)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
